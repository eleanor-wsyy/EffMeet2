# LiveKit public deployment — environment template. NOT-VERIFIED.
# Copy to a real .env (never committed) and fill secrets. Do NOT put secrets in
# source, images, or logs. The repo has no .env auto-loader; export before launch.

# --- LiveKit server / cloud ---
# Self-hosted: wss://rtc.your-domain  |  Cloud: wss://<project>.livekit.cloud
LIVEKIT_URL=wss://rtc.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Token service (deploy/livekit/token_service.py) ---
# mock = synthetic remote_1/remote_2 only (bench parity, NOT production auth)
# production = ProductionIdentityProvider stub (raises until wired) -> NOT-VERIFIED
EFFMEET_TOKEN_PROVIDER=mock
EFFMEET_TOKEN_SERVICE_HOST=127.0.0.1
EFFMEET_TOKEN_SERVICE_PORT=8790

# --- Relay (services/relay) ---
# The relay subscribes one room per meeting and runs offline ASR on remote audio
# (services/relay/livekit_bridge.py). It needs ASR configured; see relay README.
FUNASR_WS_URL=ws://127.0.0.1:10096
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_VL_MODEL=qwen3-vl-plus

# --- Controller DB ---
# EFFMEET_DB_PATH=data/bench.sqlite3
# EFFMEET_SQLITE_JOURNAL_MODE=DELETE
