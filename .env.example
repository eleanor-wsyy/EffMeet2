# Optional: set this environment variable before launch. No .env auto-loader.
# EFFMEET_DB_PATH=data/demo.sqlite3
# Mock-only runtime: no API keys, microphone or robot credentials needed.
# QWEN_API_KEY=sk-xxx  # 千问 DashScope API Key（仅存服务端，不设则走 mock 模式）
# QWEN_MODEL=qwen-plus  # 千问模型版本（可选，默认 qwen-plus）
# LIVEKIT_URL=wss://your-project.livekit.cloud  # LiveKit 服务地址（Cloud 免费层或本地 livekit-server）
# LIVEKIT_API_KEY=xxx  # 仅存服务端
# LIVEKIT_API_SECRET=xxx  # 仅存服务端
